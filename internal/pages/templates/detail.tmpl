{{define "detail"}}
<main>
<section class="detail-card">
<a class="back" href="../index.html">← 返回列表</a>
<div class="d-head">
<div>
<div class="d-pills">{{template "type-pill" .Script}}{{template "version-pill" .Script}}{{template "status-badge" .Script}}{{if .Script.Deleted}}<span class="pill" data-tip="该脚本已从注册表下架">已下架</span>{{end}}</div>
<h3>{{.Script.Name}}</h3>
</div>
{{if not .Script.Deleted}}{{template "install-btn" .Install}}{{end}}
</div>
<div class="d-meta"><span><i>作者</i>{{.Author}}</span>{{if .When}}<span><i>更新</i>{{.When}}</span>{{end}}<span><i>匹配规则</i>{{if .Matches}}{{range $i, $m := .Matches}}{{if $i}} {{end}}<code>{{$m}}</code>{{end}}{{else}}-{{end}}</span></div>
{{if .Description}}<p class="sc-desc">{{.Description}}</p>{{end}}
<section class="d-doc">{{.DocHTML}}</section>
{{if .HasPosts}}{{$first := index .Posts 0}}
<section class="d-disc">
<div class="disc-head">{{template "icon-comment"}}讨论
<span class="disc-badges" id="discBadges">{{template "post-badges" $first}}</span>
<span class="grow"></span>
{{if $first.URL}}<a id="discLink" href="{{$first.URL}}" target="_blank" rel="noopener noreferrer">在 GitHub 打开本帖 →</a>{{end}}
<div class="disc-ver">
<button type="button" class="disc-ver-btn" id="discVerBtn" aria-haspopup="listbox" aria-expanded="false" aria-label="切换讨论版本"><span id="discVerLabel">{{$first.Label}}</span><svg class="chev" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg></button>
<div class="disc-ver-menu" id="discVerMenu" role="listbox" aria-label="选择版本帖" hidden>
{{range $i, $p := .Posts}}<button type="button" class="disc-ver-item{{if eq $i 0}} active{{end}}" role="option" aria-selected="{{if eq $i 0}}true{{else}}false{{end}}" data-i="{{$i}}">{{$p.Label}}{{if $p.Number}}<span class="num">#{{$p.Number}}</span>{{end}}</button>{{end}}
</div>
</div>
</div>
<div id="discComments">
{{if $first.Comments}}{{range $first.Comments}}{{template "cmt" .}}{{end}}{{else}}{{template "empty-state" $.EmptyComments}}{{end}}
</div>
<template id="discEmpty">{{template "empty-state" .EmptyComments}}</template>
<script type="application/json" id="discData">{{.DiscJSON}}</script>
</section>
{{else}}
<section class="d-disc">
<div class="disc-head">{{template "icon-comment"}}讨论</div>
{{template "empty-state" .FallbackPanel}}
</section>
{{end}}
<section class="d-doc">
<h2>更新历史</h2>
{{if .Changelog}}
<table>
<thead><tr><th>版本</th><th>日期</th><th>说明</th></tr></thead>
<tbody>{{range .Changelog}}<tr><td>{{.Version}}</td><td>{{.Date}}</td><td>{{.Note}}</td></tr>{{end}}</tbody>
</table>
{{else}}{{template "empty-state" .EmptyChangelog}}{{end}}
</section>
</section>
</main>
{{end}}
