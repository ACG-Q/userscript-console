{{define "detail"}}
<!doctype html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{.Script.Name}} · v{{.Script.Version}}</title>
    <style>
        :root { --bg: #fafafa; --card-bg: #fff; --border: #e0e0e0; --text: #333; --muted: #666; --accent: #1a73e8; }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; background: var(--bg); color: var(--text); line-height: 1.6; }
        .container { max-width: 800px; margin: 0 auto; padding: 2rem 1rem; }
        h1 { margin-bottom: 0.5rem; }
        .meta { color: var(--muted); margin-bottom: 1.5rem; }
        .section { background: var(--card-bg); border: 1px solid var(--border); border-radius: 8px; padding: 1.5rem; margin-bottom: 1rem; }
        .section h2 { font-size: 1.1rem; margin-bottom: 1rem; border-bottom: 1px solid var(--border); padding-bottom: 0.5rem; }
        table { width: 100%; border-collapse: collapse; }
        td, th { padding: 0.5rem; border: 1px solid var(--border); text-align: left; }
        th { background: #f5f5f5; }
        .btn { display: inline-block; padding: 0.5rem 1rem; border-radius: 4px; text-decoration: none; font-size: 0.9rem; }
        .btn-primary { background: var(--accent); color: #fff; }
        .btn-secondary { background: #f1f3f4; color: var(--text); }
        .tombstone { border-color: #c5221f; background: #fce8e6; }
        .tab { display: inline-block; padding: 0.5rem 1rem; cursor: pointer; border-bottom: 2px solid transparent; }
        .tab.active { border-bottom-color: var(--accent); color: var(--accent); }
        .tab-content { display: none; }
        .tab-content.active { display: block; }
    </style>
</head>
<body>
    <div class="container">
        <h1>{{.Script.Name}} <small>v{{.Script.Version}}</small></h1>
        <div class="meta">
            {{if .Script.Deleted}}<strong>已下架</strong> · {{else}}{{if .Script.Enabled}}已启用{{else}}已停用{{end}}{{end}}
            · {{.Script.Type}} · ID: {{.Script.ID}}
        </div>

        <div class="section {{if .Script.Deleted}}tombstone{{end}}">
            <h2>安装规则</h2>
            {{if .Matches}}
            <table>
                <tr><th>#</th><th>规则</th></tr>
                {{range $i, $m := .Matches}}<tr><td>{{$i}}</td><td>{{$m}}</td></tr>{{end}}
            </table>
            {{else}}<p>无匹配规则</p>{{end}}
        </div>

        {{if .Grants}}
        <div class="section">
            <h2>权限</h2>
            <ul>
                {{range .Grants}}<li>{{.}}</li>{{end}}
            </ul>
        </div>
        {{end}}

        {{if .Changelog}}
        <div class="section">
            <h2>更新日志</h2>
            <table>
                <tr><th>版本</th><th>日期</th><th>说明</th></tr>
                {{range .Changelog}}<tr><td>{{.Version}}</td><td>{{.Date}}</td><td>{{.Note}}</td></tr>{{end}}
            </table>
        </div>
        {{end}}

        {{if .HasDiscussion}}
        <div class="section">
            <h2>版本讨论</h2>
            <div id="discTabs">
                {{range $i, $d := .Discussions}}
                <span class="tab {{if eq $i 0}}active{{end}}" data-tab="{{$i}}">v{{.Version}}</span>
                {{end}}
            </div>
            {{range $i, $d := .Discussions}}
            <div class="tab-content {{if eq $i 0}}active{{end}}" id="tab-{{$i}}">
                <p><a href="{{$d.URL}}">查看原版讨论帖</a></p>
                {{if $d.Comments}}
                <h3>评论</h3>
                {{range $d.Comments}}
                <div style="border-top:1px solid var(--border); padding:0.75rem 0;">
                    <strong>{{.Author}}</strong> <span style="color:var(--muted)">{{call $.RelativeTime .CreatedAt}}</span>
                    <div>{{.Body}}</div>
                </div>
                {{end}}
                {{else}}
                <p style="color:var(--muted)">暂无评论</p>
                {{end}}
            </div>
            {{end}}
            <script>
            (function(){
                var tabs = document.querySelectorAll('#discTabs .tab');
                var contents = document.querySelectorAll('.tab-content');
                tabs.forEach(function(t, i) {
                    t.onclick = function() {
                        tabs.forEach(function(x){x.classList.remove('active')});
                        contents.forEach(function(x){x.classList.remove('active')});
                        t.classList.add('active');
                        contents[i].classList.add('active');
                    };
                });
            })();
            </script>
        </div>
        {{else if gt .IssueNumber 0}}
        <div class="section">
            <h2>面板 Issue</h2>
            <p>Issue #{{.IssueNumber}}（评论数将在在线同步后显示）</p>
        </div>
        {{end}}

        {{if not .Script.Deleted}}
        <div class="section">
            <a class="btn btn-primary" href="{{.PagesBase}}/dist/{{.Script.ID}}.user.js">下载脚本</a>
            <a class="btn btn-secondary" href="/">返回首页</a>
        </div>
        {{end}}
    </div>
</body>
</html>
{{end}}
