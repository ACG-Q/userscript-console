{{define "script-detail"}}
<!doctype html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{.Script.Title}} - 脚本详情</title>
    <link rel="stylesheet" href="/static/components.css">
</head>
<body>
    <div class="container">
        <header>
            <h1>{{.Script.Title}}</h1>
            <div class="meta">
                <span>类型: {{.Script.Type}}</span>
                <span>版本: {{.Script.Version}}</span>
            </div>
        </header>
        
        <main>
            {{if .Script.Description}}
            <section class="description">
                <p>{{.Script.Description}}</p>
            </section>
            {{end}}
            
            <section class="actions">
                <h3>操作</h3>
                <ul>
                    {{if .Script.Enabled}}
                    <li>
                        <a href="/script/{{.Script.ID}}/enable" class="btn">禁用</a>
                    </li>
                    {{else}}
                    <li>
                        <a href="/script/{{.Script.ID}}/enable" class="btn">启用</a>
                    </li>
                    {{end}}
                    <li>
                        <a href="/script/{{.Script.ID}}/delete" class="btn btn-danger">删除</a>
                    </li>
                </ul>
            </section>
            
            {{if .Script.RawHTML}}
            <section class="script-body">
                <h4>脚本正文</h4>
                <div class="body-content">
                    {{.Script.RawHTML}}
                </div>
            </section>
            {{end}}
        </main>
    </div>
    
    <script src="/static/list/list.js"></script>
</body>
</html>
{{end}}