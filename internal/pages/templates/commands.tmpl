{{define "commands"}}
<main>
<section class="detail-card">
<h3 class="cmd-title">命令归档</h3>
<p class="cmd-sub">{{.Note}}</p>
{{if .Entries}}
{{range .Entries}}
<article class="cmd-item">
<div class="cmd-line"><b>{{.Author}}</b><time>{{.When}}</time><span class="cmd-no">#{{.No}}</span></div>
<pre>{{.Command}}</pre>
{{if .Results}}{{range .Results}}<div class="cmd-res"><div class="cmd-line"><b>{{.Author}}</b><time>{{.When}}</time></div><pre>{{.Body}}</pre></div>{{end}}{{else}}<p class="cmd-none">没有执行结果</p>{{end}}
</article>
{{end}}
{{else}}
{{template "empty-state" .EmptyPanel}}
{{end}}
{{if gt .TotalPages 1}}
<nav class="pager" aria-label="分页">
{{if gt .Page 1}}<a class="btn ghost" href="page-{{sub .Page 1}}.html">上一页</a>{{end}}
<span class="pager-now">第 {{.Page}} / {{.TotalPages}} 页</span>
{{if lt .Page .TotalPages}}<a class="btn ghost" href="page-{{add .Page 1}}.html">下一页</a>{{end}}
</nav>
{{end}}
</section>
</main>
{{end}}
