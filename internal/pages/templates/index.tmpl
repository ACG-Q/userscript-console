{{define "index"}}
<section class="hero">
<h1>脚本控制台</h1>
<p class="sub">基于 GitHub Issues 的全自动脚本管理：在命令面板里用 <code>/add</code>、<code>/up</code> 管理脚本，每个脚本拥有独立讨论区，安装即可可用。</p>
<div class="stats">
<div class="stat" data-tip="注册表中的脚本总数"><b>{{.Total}}</b><span>脚本总数</span></div>
<div class="stat" data-tip="全部脚本讨论的回复总数"><b>{{.Replies}}</b><span>讨论回复</span></div>
<div class="stat" data-tip="已被标记为已解决的讨论数"><b>{{.Answered}}</b><span>已解决反馈</span></div>
</div>
</section>
<main>
<h2 class="sec">脚本列表
<span class="filters">
<button class="chip active" type="button" data-filter="all">全部</button>
<button class="chip" type="button" data-filter="self">自写</button>
<button class="chip" type="button" data-filter="synced">同步</button>
</span>
</h2>
<div id="scriptList" data-batch="{{.Batch}}" data-total="{{.Total}}">
{{if .Cards}}{{range .Cards}}{{template "script-card" .}}{{end}}
{{if .HasMore}}<div id="listSentinel" aria-hidden="true"></div>
<button class="btn ghost" type="button" id="loadMore">加载更多</button>
<p class="list-end" id="listEnd" hidden>已全部加载（共 {{.Total}} 个）</p>{{end}}
{{else}}{{template "empty-state" .ListEmpty}}{{end}}
</div>
{{if .Cards}}{{template "empty-state" .FilterEmpty}}{{end}}
</main>
{{end}}
